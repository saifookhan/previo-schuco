# Reverse proxy + automatic HTTPS (Let's Encrypt) for the selfhost profile.
# {$DOMAIN} is substituted from the DOMAIN env var (see docker-compose.yml's
# caddy service / README's self-host section) — e.g. a free sslip.io name
# like 188-245-28-215.sslip.io, or a real domain once one exists. Falls
# back to :80 (plain HTTP, no cert — DOMAIN unset means local/no-TLS use).
{$DOMAIN:-:80} {
	reverse_proxy web:3000
}

# Mailpit's web UI, behind its own HTTPS cert on a subdomain — set
# MAILPIT_DOMAIN (e.g. mail.188-245-28-215.sslip.io) to enable. Falls
# back to :8080, an unpublished container-internal port (nothing to
# break) when unset — MAILPIT_DOMAIN is opt-in, unlike DOMAIN above.
# Mailpit's own MAILPIT_UI_AUTH Basic Auth (see README) still applies —
# Caddy only adds TLS in front of it, doesn't replace it.
{$MAILPIT_DOMAIN:-:8080} {
	reverse_proxy mailpit:8025
}

# This documentation site (apps/docs), on its own subdomain — set
# DOCS_DOMAIN (e.g. docs.188-245-28-215.sslip.io) to enable. Publicly
# readable, no login. Falls back to an unpublished internal port when unset.
{$DOCS_DOMAIN:-:8081} {
	reverse_proxy docs:80
}

# PREVIO local development env — per-target composition (ADR 0005)
#
# Copy to .env.local (NOT .env — see docs/environments.md). `DB_TARGET`,
# `REDIS_TARGET`, `API_TARGET` pick which environment each dependency
# points at: `local` (values live right here), `dev`/`staging` (values
# live in .env.dev.local / .env.staging.local instead, fetched via
# `pnpm env:fetch <target>` — never hand-typed, see ADR 0011). There is no
# `production` target reachable from local dev, ever.

# ── Target selection ─────────────────────────────────────────────────
DB_TARGET=local
REDIS_TARGET=local
API_TARGET=local

# ── 'local' target values — local Docker creds, not real secrets ──────
# Restricted previo_app role (ADR 0007) — matches docker-compose.yml.
# Port 5434 here because docker-compose.yml maps postgres to 5434:5432
# locally (avoids clashing with another local Postgres on the default 5432).
DATABASE_URL_LOCAL=postgresql://previo_app:previo_app@localhost:5434/previo
REDIS_URL_LOCAL=redis://localhost:6380
API_URL_LOCAL=http://localhost:3001

# ── Non-target-resolved values ───────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Must match docker-compose.yml's APP_DB_PASSWORD for the previo_app role.
APP_DB_PASSWORD=previo_app

# Shared session-JWT signing secret — apps/web signs with it, apps/api
# verifies with it (see apps/api/src/lib/session-jwt.ts). Generate:
#   openssl rand -base64 32
# IMPORTANT: `pnpm dev`'s Node processes read THIS file (.env.local), but
# `docker compose up` reads a plain `.env` file instead (Compose's own
# auto-loaded convention, separate from .env.local — see ADR 0005). If
# you run apps/api via Docker (the default `docker compose up -d`) while
# running `pnpm dev` for web on the host, put the SAME value in both
# .env.local and a root .env file, or web-signed sessions won't verify
# against the dockerized api.
AUTH_SECRET=

# Dev-only "log in as a seeded demo user, no password" shortcut — shown
# on /login only when this is true. Leave it on for local dev.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=true

# Invite/password-reset emails — apps/api/src/lib/email.ts tries, in
# order: Resend (below, if RESEND_API_KEY set) -> SMTP (if SMTP_HOST
# set) -> log the link to the console.
#
# docker-compose already runs a local SMTP catcher (`mailpit` — web UI
# at http://localhost:8025) and points the dockerized api at it, so if
# you're running apps/api via `docker compose up -d` (the default —
# see the README) you don't need to set anything here to see real
# "sent" emails. These two only matter if you run apps/api directly on
# the host instead (`pnpm dev:api`/`dev:local`) and still want to hit
# that same mailpit container:
SMTP_HOST=
SMTP_PORT=1025

# Resend (https://resend.com) — set this to send real email instead
# (always takes priority over SMTP, wherever apps/api runs).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Demo users (seeded — see packages/db/src/demo-users.ts). Dev-login only
# (no password) — real accounts go through /set-password after being
# invited from the admin panel.
# admin@schuco-demo.it          super-admin
# elena.costa@schuco-demo.it    company-admin (inactive)
# admin@suppli-demo.it          company-admin
# admin@technometal-demo.it     company-admin
# manager@technometal-demo.it   super-user
# sales@technometal-demo.it     user
# admin@fabbrikka-demo.it       company-admin

# PREVIO local development env — per-target composition (ADR 0005)
#
# Copy to .env.local (NOT .env — see docs/environments.md). `DB_TARGET`,
# `REDIS_TARGET`, `API_TARGET` pick which environment each dependency
# points at: `local` (values live right here), `dev`/`staging` (values
# live in .env.dev.local / .env.staging.local instead, fetched via
# `pnpm env:fetch <target>` — never hand-typed, see ADR 0011). There is no
# `production` target reachable from local dev, ever.

# ── Target selection ─────────────────────────────────────────────────
DB_TARGET=local
REDIS_TARGET=local
API_TARGET=local

# ── 'local' target values — local Docker creds, not real secrets ──────
# Restricted previo_app role (ADR 0007) — matches docker-compose.yml.
# Port 5434 here because docker-compose.yml maps postgres to 5434:5432
# locally (avoids clashing with another local Postgres on the default 5432).
DATABASE_URL_LOCAL=postgresql://previo_app:previo_app@localhost:5434/previo
REDIS_URL_LOCAL=redis://localhost:6380
API_URL_LOCAL=http://localhost:3001

COGNITO_REGION_LOCAL=eu-central-1
COGNITO_USER_POOL_ID_LOCAL=
COGNITO_CLIENT_ID_LOCAL=
COGNITO_DOMAIN_LOCAL=

# ── Non-target-resolved values ───────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Must match docker-compose.yml's APP_DB_PASSWORD for the previo_app role.
APP_DB_PASSWORD=previo_app

# Session encryption for apps/web (generate: openssl rand -base64 32)
AUTH_SECRET=

# Demo users (seeded — see packages/db/src/demo-users.ts)
# admin@schuco-demo.it          super-admin
# elena.costa@schuco-demo.it    company-admin (inactive)
# admin@suppli-demo.it          company-admin
# admin@technometal-demo.it     company-admin
# manager@technometal-demo.it   super-user
# sales@technometal-demo.it     user
# admin@fabbrikka-demo.it       company-admin

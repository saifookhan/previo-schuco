# PREVIO local / dev environment variables
# Copy to .env and fill in Cognito values from Terraform outputs

# Database
DATABASE_URL=postgresql://previo:previo@localhost:5432/previo

# API
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3001
# Planned microservices (OpenAPI server URLs only — not running in Phase 1)
CALCULATION_SERVICE_URL=http://localhost:3002
FILES_SERVICE_URL=http://localhost:3003

# AWS Cognito (from terraform output)
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COGNITO_REGION=eu-central-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=

# Demo users (seeded — see packages/db/src/demo-users.ts)
# admin@schuco-demo.it          super-admin
# elena.costa@schuco-demo.it    company-admin (inactive)
# admin@suppli-demo.it          company-admin
# admin@technometal-demo.it     company-admin
# manager@technometal-demo.it   super-user
# sales@technometal-demo.it     user
# admin@fabbrikka-demo.it       company-admin

# Session encryption (generate: openssl rand -base64 32)
AUTH_SECRET=

# Static file server for the built docs site, inside the `docs` container.
# TLS is handled by the main Caddy (repo-root Caddyfile), which proxies
# DOCS_DOMAIN to this container over the internal Docker network.
:80 {
	root * /srv
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

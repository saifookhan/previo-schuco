{
  "name": "@schuco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "pretest": "pnpm --filter @schuco/db test:db:setup",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.699.0",
    "@hono/node-server": "^1.14.1",
    "@hono/swagger-ui": "^0.6.1",
    "@schuco/calculation": "workspace:*",
    "@schuco/contracts": "workspace:*",
    "@schuco/db": "workspace:*",
    "@schuco/env": "workspace:*",
    "@schuco/queue": "workspace:*",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "jszip": "^3.10.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "drizzle-orm": "^0.44.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}

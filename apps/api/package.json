{
  "name": "@schuco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc && tsc -p tsconfig.scripts.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "seed:demo-family": "tsx scripts/seed-demo-family.ts",
    "sample:workbook": "tsx scripts/sample-workbook.ts",
    "pretest": "pnpm --filter @schuco/db test:db:setup",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/swagger-ui": "^0.6.1",
    "@schuco/calculation": "workspace:*",
    "@schuco/contracts": "workspace:*",
    "@schuco/db": "workspace:*",
    "@schuco/env": "workspace:*",
    "@schuco/queue": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "jszip": "^3.10.2",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.20.2",
    "pino": "~10.3.1",
    "resend": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "drizzle-orm": "^0.44.2",
    "pino-pretty": "~13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
